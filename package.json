{
  "name": "global-business-scraper-admin",
  "private": true,
  "version": "1.0.0",
  "description": "Global Business Scraper Admin — PHP + Tailwind CSS",
  "scripts": {
    "build:css": "tailwindcss -i ./resources/css/app.css -o ./public/assets/app.css --minify",
    "watch:css": "tailwindcss -i ./resources/css/app.css -o ./public/assets/app.css --watch",
    "serve": "php -S 127.0.0.1:9010 -t public public/router.php",
    "test": "php tests/run.php",
    "test:browser": "node tests/browser.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.65.1",
    "tailwindcss": "3.4.17"
  }
}
