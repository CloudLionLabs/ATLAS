APP_NAME="Atlas 全球运营"
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=9010
APP_URL=http://google.test
APP_TIMEZONE=UTC
SESSION_NAME=atlas_gbs_session

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=atlas_global
DB_USERNAME=root
DB_PASSWORD=root
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
GEO_DB_PATH=storage/geo.sqlite

SCRAPER_BASE_URL=http://127.0.0.1:8080
SCRAPER_CONNECT_TIMEOUT=5
SCRAPER_READ_TIMEOUT=45
SCRAPER_POLL_INTERVAL=10
SCRAPER_MAX_CONCURRENT_JOBS=1

GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT="AtlasGlobalBusinessAdmin/1.0 (local admin console)"
GEOCODER_LANGUAGE=zh-CN,en

TILE_PROVIDER=carto_dark
MAP_DEFAULT_LAT=20.0
MAP_DEFAULT_LNG=10.0
MAP_DEFAULT_ZOOM=2

INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=Atlas!2026
INITIAL_ADMIN_NAME=管理员
